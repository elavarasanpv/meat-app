{
  "expo": {
    "name": "Thanjoz Mart Partner",
    "slug": "freshcut-partner",
    "scheme": "thanjozmart-partner",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.thanjozmart.partner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png",
        "backgroundColor": "#1C1715"
      },
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thanjoz Mart uses your location to show nearby delivery offers and let customers follow your ride.",
          "locationAlwaysAndWhenInUsePermission": "While you're online, Thanjoz Mart shares your location even with the screen off so customers can follow your ride and your trip km are counted.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Thanjoz Mart uses the camera for scale photos of packed orders and doorstep photos on deliveries."
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#E4461F",
          "defaultChannel": "orders",
          "sounds": [
            "./assets/sounds/thanjozmart_order.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#E4461F",
          "android": {
            "image": "./assets/brand/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#E4461F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddc074a9-fa36-4745-8c1f-62b417c7e1cb"
      }
    },
    "owner": "elavarasanp",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "backgroundColor": "#E4461F",
      "resizeMode": "contain"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    }
  }
}
