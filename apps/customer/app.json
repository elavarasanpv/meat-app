{
  "expo": {
    "name": "FreshCut",
    "slug": "freshcut-customer",
    "scheme": "freshcut",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.freshcut.customer",
      "adaptiveIcon": {
        "backgroundColor": "#E4461F"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_MAPS_ANDROID_KEY}"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
