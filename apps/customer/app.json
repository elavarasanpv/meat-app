{
  "expo": {
    "name": "Thanjoz Mart",
    "slug": "freshcut-customer",
    "scheme": "thanjozmart",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.thanjozmart.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png",
        "backgroundColor": "#E4461F"
      },
      "config": {
        "googleMaps": {}
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#E4461F",
          "sounds": [
            "./assets/sounds/thanjozmart_arrived.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Thanjoz Mart uses the camera so you can show us a photo of your order when something is wrong.",
          "photosPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#E4461F",
          "android": {
            "image": "./assets/brand/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#E4461F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e32d7f6-cf83-4a1f-a59b-8961917621ac"
      }
    },
    "owner": "elavarasanp",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "backgroundColor": "#E4461F",
      "resizeMode": "contain"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    }
  }
}
