{
  "expo": {
    "name": "FreshCut",
    "slug": "freshcut-customer",
    "scheme": "freshcut",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.freshcut.customer",
      "adaptiveIcon": {
        "backgroundColor": "#E4461F"
      },
      "config": {
        "googleMaps": {}
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#E4461F",
          "sounds": [
            "./assets/sounds/freshcut_arrived.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e32d7f6-cf83-4a1f-a59b-8961917621ac"
      }
    },
    "owner": "elavarasanp"
  }
}
