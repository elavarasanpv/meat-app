EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3001
# Google Maps SDK for Android key (only needed for real APK builds; Expo Go has its own)
GOOGLE_MAPS_ANDROID_KEY=
# Photo CDN in front of Supabase storage; leave empty to load photos from Supabase directly
EXPO_PUBLIC_IMAGE_CDN=https://img.thanjozmart.com
